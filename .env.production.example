APP_NAME="Bantay Presyo"
APP_ENV=production
# Generate with: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

# Domain Caddy serves and gets a TLS certificate for. Use :80 to serve plain HTTP behind another proxy.
SERVER_NAME=api.example.com

FRONTEND_URL=https://example.com
CORS_ALLOWED_ORIGINS=https://example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bantay_presyo
DB_USERNAME=bantay
DB_PASSWORD=change-me

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_EXPIRATION=43200

PRICE_FLAG_THRESHOLD_PERCENT=30
PRICE_REPORTS_PER_MINUTE=10
PRICE_REPORTS_PER_DAY=200
PRICE_ANALYTICS_CACHE_SECONDS=300
